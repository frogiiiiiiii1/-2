            TweenService:Create(Pill, TweenInfo.new(0.15),
                {BackgroundColor3 = s and THEME.Accent or THEME.Pill}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.22, Enum.EasingStyle.Back),
                {Position = s and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
        end
        Btn.MouseButton1Click:Connect(function()
            render(not state)
            if cb then cb(state) end
            Window:setStatus(text .. " → " .. (state and "ON" or "OFF"))
        end)
        render(false)
    end

    local function makeSlider(parent, text, tooltip, max, min, cb)
        max = max or 100; min = min or 0
        local holder = new("Frame", {
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = THEME.BgCard,
            BackgroundTransparency = 0.15,
            BorderSizePixel = 0,
            ZIndex = 21,
            Parent = parent,
        })
        corner(holder, 8)
        grad(holder, 90, ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 24, 38)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 16, 26))}))
        stroke(holder, THEME.Border, 1, 0.55)

        new("TextLabel", {
            Size = UDim2.new(1, -28, 0, 18),
            Position = UDim2.new(0, 16, 0, 8),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 21,
            Parent = holder,
        })

        local valLbl = new("TextLabel", {
            Size = UDim2.fromOffset(60, 18),
            Position = UDim2.new(1, -74, 0, 8),
            BackgroundTransparency = 1,
            Text = tostring(min),
            TextColor3 = THEME.AccentGlow,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 21,
            Parent = holder,
        })

        local track = new("TextButton", {
            Size = UDim2.new(1, -32, 0, 12),
            Position = UDim2.new(0, 16, 0, 32),
            BackgroundColor3 = THEME.BgCardHover,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 21,
            Parent = holder,
        })
        corner(track, 999)

        local fill = new("Frame", {
            BackgroundColor3 = THEME.Accent,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0),
            ZIndex = 22,
            Parent = track,
        })
        corner(fill, 999)
        grad(fill, 0, ColorSequence.new({
            ColorSequenceKeypoint.new(0, THEME.AccentDeep),
            ColorSequenceKeypoint.new(0.5, THEME.Accent),
            ColorSequenceKeypoint.new(1, THEME.AccentGlow)}))

        local knob = new("Frame", {
            Size = UDim2.fromOffset(14, 14),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = THEME.TextOn,
            BorderSizePixel = 0,
            ZIndex = 23,
            Parent = track,
        })
        corner(knob, 999)
        stroke(knob, THEME.AccentGlow, 2)

        local dragging = false
        local currentVal = min

        local function apply(rel, tween)
            rel = math.clamp(rel, 0, 1)
            local v = math.floor(min + rel * (max - min) + 0.5)
            currentVal = v
            valLbl.Text = tostring(v)
            if tween then
                TweenService:Create(fill, TweenInfo.new(0.15),
                    {Size = UDim2.new(rel, 0, 1, 0)}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15),
                    {Position = UDim2.new(rel, 0, 0.5, 0)}):Play()
            else
                fill.Size = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
            end
            if cb then cb(v) end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                apply((input.Position.X - track.AbsolutePosition.X)
                    / track.AbsoluteSize.X, false)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                apply((input.Position.X - track.AbsolutePosition.X)
                    / track.AbsoluteSize.X, false)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        return holder, function(v) apply((v - min) / (max - min), true) end
    end

    local function makeButton(parent, text, tooltip, cb)
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, cardHeight),
            BackgroundColor3 = THEME.Accent,
            BorderSizePixel = 0,
            Text = text,
            TextColor3 = THEME.TextOn,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            AutoButtonColor = false,
            ZIndex = 21,
            Parent = parent,
        })
        corner(btn, 8)
        grad(btn, 90, ColorSequence.new({
            ColorSequenceKeypoint.new(0, THEME.AccentGlow),
            ColorSequenceKeypoint.new(1, THEME.Accent)}))
        btn.MouseButton1Click:Connect(function()
            if cb then cb() end
            Window:setStatus("action: " .. text)
        end)
        return btn
    end

    local function makeKeybind(parent, text, tooltip, defaultKey, cb)
        local row = new("TextButton", {
            Size = UDim2.new(1, 0, 0, cardHeight),
            BackgroundColor3 = THEME.BgCard,
            BackgroundTransparency = 0.15,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 21,
            Parent = parent,
        })
        corner(row, 8)
        stroke(row, THEME.Border, 1, 0.55)

        new("TextLabel", {
            Size = UDim2.new(0.5, -10, 1, 0),
            Position = UDim2.new(0, 16, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 22,
            Parent = row,
        })

        local keyLbl = new("TextLabel", {
            Size = UDim2.new(0.5, -20, 1, 0),
            Position = UDim2.new(0.5, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(defaultKey):gsub("Enum.KeyCode.", ""),
            TextColor3 = THEME.AccentGlow,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 22,
            Parent = row,
        })

        local waiting = false
        local currentKey = defaultKey

        row.MouseButton1Click:Connect(function()
            waiting = true
            keyLbl.Text = "..."
            keyLbl.TextColor3 = THEME.Danger
        end)

        UserInputService.InputBegan:Connect(function(input, gpe)
            if waiting and input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    waiting = false
                    keyLbl.Text = tostring(currentKey):gsub("Enum.KeyCode.", "")
                    keyLbl.TextColor3 = THEME.AccentGlow
                    return
                end
                if input.KeyCode ~= Enum.KeyCode.Unknown then
                    waiting = false
                    currentKey = input.KeyCode
                    keyLbl.Text = tostring(currentKey):gsub("Enum.KeyCode.", "")
                    keyLbl.TextColor3 = THEME.AccentGlow
                    return
                end
            end
            if not gpe and not waiting and input.KeyCode == currentKey then
                if cb then cb(currentKey) end
            end
        end)

        return row
    end

    --============================================================
    -- TAB API
    --============================================================
    local TabAPI = {}

    function TabAPI:NewTab(tabName)
        local order = 0
        for _ in pairs(Window.Tabs) do order = order + 1 end

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = THEME.BgSidebar,
            BackgroundTransparency = 0.15,
            BorderSizePixel = 0,
            Text = "  " .. tabName,
            TextColor3 = THEME.TextDim,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            LayoutOrder = order,
            ZIndex = 22,
            Parent = sideList,
        })
        corner(btn, 8)
        Instance.new("UIPadding", btn).PaddingLeft = UDim.new(0, 12)

        local tab = {subs = {}, _order = 0}
        Window.Tabs[tabName] = tab
        Window.tabButtons[tabName] = btn

        btn.MouseButton1Click:Connect(function()
            Window:_selectTab(tabName)
        end)
        btn.MouseEnter:Connect(function()
            if Window.currentTab ~= tabName then
                TweenService:Create(btn, TweenInfo.new(0.15),
                    {BackgroundColor3 = THEME.BgCard}):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if Window.currentTab ~= tabName then
                TweenService:Create(btn, TweenInfo.new(0.15),
                    {BackgroundColor3 = THEME.BgSidebar}):Play()
            end
        end)

        local NewTabObj = {}

        function NewTabObj:NewSection(sectionName)
            tab._order = tab._order + 1
            local orderIdx = tab._order

            local sbtn = new("TextButton", {
                Size = UDim2.fromOffset(0, 24),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = THEME.BgCard,
                BackgroundTransparency = 0.15,
                BorderSizePixel = 0,
                Text = "  " .. sectionName .. "  ",
                TextColor3 = THEME.TextDim,
                Font = Enum.Font.GothamBold,
                TextSize = 10,
                AutoButtonColor = false,
                LayoutOrder = orderIdx,
                Visible = false,
                ZIndex = 23,
                Parent = SubBar,
            })
            corner(sbtn, 999)
            Instance.new("UIPadding", sbtn).PaddingLeft = UDim.new(0, 6)

            local container = new("Frame", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Visible = false,
                ZIndex = 21,
                Parent = PageScroll,
            })

            local scroll = new("ScrollingFrame", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = THEME.Accent,
                ScrollBarImageTransparency = 0.5,
                ZIndex = 21,
                Parent = container,
            })
            local ll = Instance.new("UIListLayout", scroll)
            ll.SortOrder = Enum.SortOrder.LayoutOrder
            ll.Padding = UDim.new(0, 6)
            local scp = Instance.new("UIPadding", scroll)
            scp.PaddingTop = UDim.new(0, 2)
            scp.PaddingBottom = UDim.new(0, 8)
            scp.PaddingLeft = UDim.new(0, 2)
            scp.PaddingRight = UDim.new(0, 6)

            tab.subs[sectionName] = {
                button = sbtn,
                container = container,
                scroll = scroll,
                order = orderIdx,
            }

            sbtn.MouseButton1Click:Connect(function()
                if Window.currentTab ~= tabName then return end
                setSubActive(tab, sectionName)
                Window:setStatus("opened: " .. tabName .. " → " .. sectionName)
            end)

            local SectionAPI = {_order = 0}
            local function nextOrder()
                SectionAPI._order = SectionAPI._order + 1
                return SectionAPI._order
            end

            function SectionAPI:NewToggle(text, tooltip, cb)
                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, cardHeight),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    Parent = scroll,
                })
                makeToggle(holder, text, tooltip, cb)
                local t = holder:GetChildren()[1]
                if t then t.Size = UDim2.new(1, 0, 1, 0) end
                return holder
            end

            function SectionAPI:NewSlider(text, tooltip, max, min, cb)
                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    Parent = scroll,
                })
                local s, setter = makeSlider(holder, text, tooltip, max, min, cb)
                s.Size = UDim2.new(1, 0, 1, 0)
                return s
            end

            function SectionAPI:NewButton(text, tooltip, cb)
                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, cardHeight),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    Parent = scroll,
                })
                local b = makeButton(holder, text, tooltip, cb)
                b.Size = UDim2.new(1, 0, 1, 0)
                return b
            end

            function SectionAPI:NewKeybind(text, tooltip, defaultKey, cb)
                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, cardHeight),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    Parent = scroll,
                })
                local k = makeKeybind(holder, text, tooltip, defaultKey, cb)
                k.Size = UDim2.new(1, 0, 1, 0)
                return k
            end

            return SectionAPI
        end

        return NewTabObj
    end

    Window.NewTab = function(self, tabName) return TabAPI:NewTab(tabName) end

    -- показать окно
    task.defer(function()
        animateOpen(true)
    end)

    return Window
end

