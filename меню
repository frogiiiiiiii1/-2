    local function setSubActive(tab, subName)
        for name, s in pairs(tab.subs) do
            if s.button and s.container then
                local on = (name == subName)
                s.button.BackgroundColor3 = on and THEME.Accent or THEME.BgCard
                s.button.TextColor3 = on and THEME.TextOn or THEME.TextDim
                s.container.Visible = on
            end
        end
    end

    local function setTabActive(tabName)
        for name, btn in pairs(Window.tabButtons) do
            local on = (name == tabName)
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = on and THEME.BgCard or THEME.BgSidebar}):Play()
            btn.TextColor3 = on and THEME.TextOn or THEME.TextDim
        end
        local btn = Window.tabButtons[tabName]
        if btn then
            TweenService:Create(indicator, TweenInfo.new(0.28, Enum.EasingStyle.Quart),
                {Position = UDim2.new(0, -1, 0,
                    btn.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y)}):Play()
            TweenService:Create(indicator, TweenInfo.new(0.28),
                {Size = UDim2.new(0, 3, 0, btn.AbsoluteSize.Y)}):Play()
            TweenService:Create(IndicatorGlow, TweenInfo.new(0.28, Enum.EasingStyle.Quart),
                {Position = UDim2.new(0, -22, 0,
                    btn.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y - 6)}):Play()
            TweenService:Create(IndicatorGlow, TweenInfo.new(0.28),
                {Size = UDim2.new(0, 60, 0, btn.AbsoluteSize.Y + 12)}):Play()
        end
    end

    function Window:_selectTab(tabName)
        if not Window.Tabs[tabName] then return end
        Window.currentTab = tabName
        setTabActive(tabName)
        for otherName, otherTab in pairs(Window.Tabs) do
            for _, s in pairs(otherTab.subs) do
                if s.button then s.button.Visible = (otherName == tabName) end
                if s.container then s.container.Visible = false end
            end
        end
        local tab = Window.Tabs[tabName]
        local first
        for subName, subData in pairs(tab.subs) do
            if not first or subData.order < tab.subs[first].order then
                first = subName
            end
        end
        if first then setSubActive(tab, first) end
    end

    --============================================================
    -- OPEN/HIDE ANIMATION
    --============================================================
    local function animateOpen(silent)
        if Window._busyAnim then return end
        Window._busyAnim = true
        Window._isOpen = true
        Backdrop.Visible = true
        Backdrop.BackgroundTransparency = 1
        TweenService:Create(Backdrop, TweenInfo.new(0.4, Enum.EasingStyle.Quart),
            {BackgroundTransparency = 0.6}):Play()

        Main.Visible = true
        Main.Size = UDim2.new(0, Window._originalSize.X.Offset * 0.85,
            0, Window._originalSize.Y.Offset * 0.85)
        Main.Position = UDim2.new(Window._originalPos.X.Scale, Window._originalPos.X.Offset,
            Window._originalPos.Y.Scale, Window._originalPos.Y.Offset + 24)
        Main.BackgroundTransparency = 1

        local restore = {}
        for _, obj in ipairs(Main:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                restore[obj] = {p="TextTransparency", v=obj.TextTransparency}
                obj.TextTransparency = 1
            elseif obj:IsA("ImageLabel") then
                restore[obj] = {p="ImageTransparency", v=obj.ImageTransparency}
                obj.ImageTransparency = math.min(obj.ImageTransparency + 0.5, 1)
            end
        end

        TweenService:Create(Main, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = Window._originalSize,
            Position = Window._originalPos,
            BackgroundTransparency = 0.08}):Play()

        for obj, info in pairs(restore) do
            if obj and obj.Parent then
                TweenService:Create(obj, TweenInfo.new(0.4, Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out), {[info.p] = info.v}):Play()
            end
        end

        task.delay(0.55, function()
            Window._busyAnim = false
            if not silent then Window:setStatus("menu opened") end
        end)
    end

    local function animateHide(silent)
        if Window._busyAnim or not Main.Visible then return end
        Window._busyAnim = true
        Window._isOpen = false

        local restore = {}
        for _, obj in ipairs(Main:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                restore[obj] = "TextTransparency"
            elseif obj:IsA("ImageLabel") then
                restore[obj] = "ImageTransparency"
            end
        end

        local t = TweenService:Create(Main,
            TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, Window._originalSize.X.Offset * 0.88,
                0, Window._originalSize.Y.Offset * 0.88),
            Position = UDim2.new(Window._originalPos.X.Scale, Window._originalPos.X.Offset,
                Window._originalPos.Y.Scale, Window._originalPos.Y.Offset + 18),
            BackgroundTransparency = 1})
        t:Play()

        for obj, prop in pairs(restore) do
            if obj and obj.Parent then
                TweenService:Create(obj, TweenInfo.new(0.35, Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In), {[prop] = 1}):Play()
            end
        end

        TweenService:Create(Backdrop, TweenInfo.new(0.4, Enum.EasingStyle.Quart,
            Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()

        t.Completed:Connect(function()
            Main.Visible = false
            Backdrop.Visible = false
            Main.Size = Window._originalSize
            Main.Position = Window._originalPos
            Main.BackgroundTransparency = 0.08
            for obj, prop in pairs(restore) do
                if obj and obj.Parent then obj[prop] = 0 end
            end
            Window._busyAnim = false
            if not silent then Window:setStatus("menu hidden") end
        end)
    end

    function Window:Toggle(silent)
        if Window._busyAnim then return end
        if Window._isOpen then animateHide(silent)
        else animateOpen(silent) end
    end

    function Window:Show() animateOpen(true) end
    function Window:Hide() animateHide(true) end

